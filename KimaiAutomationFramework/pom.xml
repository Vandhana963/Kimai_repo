<profiles>
   <profile>
      <id>SMT</id>
      <build>
         <plugins>
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-surefire-plugin</artifactId>
               <version>3.5.6</version>
               <configuration>
                  <suiteXmlFiles>
                     <suiteXmlFile>testng_SMT.xml</suiteXmlFile>
                  </suiteXmlFiles>
               </configuration>
            </plugin>     
         </plugins>
      </build>
   </profile>
   
   <profile>
      <id>RT</id>
      <build>
         <plugins>
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-surefire-plugin</artifactId>
               <version>3.5.6</version>
               <configuration>
                  <suiteXmlFiles>
                     <suiteXmlFile>testng_RT.xml</suiteXmlFile>
                  </suiteXmlFiles>
               </configuration>
            </plugin>     
         </plugins>
      </build>
   </profile>  
   <profile>
      <id>ST</id>
      <build>
         <plugins>
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-surefire-plugin</artifactId>
               <version>3.5.6</version>
               <configuration>
                  <suiteXmlFiles>
                     <suiteXmlFile>testng_ST.xml</suiteXmlFile>
                  </suiteXmlFiles>
               </configuration>
            </plugin>     
         </plugins>
      </build>
   </profile>    
</profiles>

 

